{
  "name": "gstitch-mcproxy",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-dependency HTTP proxy between MCP clients and Google Stitch's MCP endpoint, with local fallbacks, retries, SSE streaming, logging, metrics and rate limiting.",
  "type": "commonjs",
  "main": "index.js",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --experimental-test-coverage --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test",
    "probe:live": "node scripts/live-probe.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proxy",
    "stitch",
    "google-stitch"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
