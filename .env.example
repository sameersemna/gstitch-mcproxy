# ---------------------------------------------------------------------------
# gstitch-mcproxy configuration
#
# Every variable here is read by the code. `test/config.test.js` fails if this file, the code
# and PROGRESS.md drift apart, so add new settings in all three places.
#
# Owner decisions (PROGRESS.md §12) are reflected in the defaults below.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Port to listen on. 8787 is the code default; 11401 is a common local choice.
MCP_SERVER_PORT=8787
# Bind address. 0.0.0.0 keeps the proxy reachable from other LAN computers (owner decision 1).
# Set 127.0.0.1 to restrict it to this machine.
MCP_SERVER_HOST=0.0.0.0

# --- Upstream ---------------------------------------------------------------
# Stitch's MCP endpoint. Override only for testing (the test suite uses a local fake).
STITCH_URL=https://stitch.googleapis.com/mcp
# Default API key. Prefer sending X-Stitch-Api-Key per request; this is a fallback.
# Never commit a real key.
STITCH_API_KEY=
# Optional default project ID, used for log attribution and the X-Stitch-Project-Id header.
# Tools that need a project usually receive it in `arguments.projectId` instead.
STITCH_PROJECT_ID=
# Use `gcloud auth print-access-token` when no API key is available. Off by default.
ENABLE_GCLOUD_FALLBACK=0

# --- Request handling -------------------------------------------------------
# Deadline for the upstream to send response headers. Stitch generations can take 60s+.
REQUEST_TIMEOUT_MS=120000
# Hard limit on a request body.
MAX_BODY_SIZE_BYTES=10485760
# Socket timeouts. Explicit rather than Node's defaults so they are visible and tunable.
SERVER_HEADERS_TIMEOUT_MS=60000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
# Graceful shutdown drain budget.
SHUTDOWN_DRAIN_MS=15000

# --- Streaming (ADR 0004) ---------------------------------------------------
# Longest allowed silence between chunks, then the stream is ended.
STREAM_IDLE_TIMEOUT_MS=60000
# Absolute cap for one streamed response.
STREAM_MAX_DURATION_MS=1800000

# --- Upstream resilience ----------------------------------------------------
UPSTREAM_RETRY_ENABLED=true
UPSTREAM_RETRY_ATTEMPTS=3
UPSTREAM_RETRY_BASE_DELAY_MS=250
# Concurrent upstream requests, with a bounded queue: saturation answers 503 + Retry-After.
MAX_CONCURRENT_UPSTREAM=32
CONCURRENCY_QUEUE_WAIT_MS=10000

# --- Methods Stitch does not implement --------------------------------------
# Stitch resets the HTTP/2 stream for prompts/list, which clients see as "fetch failed" and
# can retry in a tight loop. Answer these locally instead.
LOCAL_FALLBACK_METHODS=prompts/list
# Extra tool names to treat as read-only (comma-separated). Overrides the built-in table.
SAFE_TOOLS=
# Extra tool names to force to unsafe, so they are never retried (comma-separated).
UNSAFE_TOOLS=

# --- Idempotency (ADR 0003) -------------------------------------------------
# How long a detached unsafe request may keep running after its client disappeared.
UNSAFE_MAX_DURATION_MS=600000
# How long a stored result may be replayed to an identical retry.
REPLAY_WINDOW_MS=600000
REPLAY_MAX_ENTRIES=200
REPLAY_MAX_TOTAL_BYTES=33554432
# Inject readOnlyHint/destructiveHint into tools/list when Stitch omits them.
ANNOTATE_TOOLS=true

# --- Security (ADR 0005) ----------------------------------------------------
# Origin policy: with no value, private-network (LAN) origins are allowed and public-internet
# origins are refused. '*' restores the old permissive behaviour — do not use it on a LAN you
# do not fully trust.
CORS_ORIGIN=
# Extra origins to allow beyond the private-network default (comma-separated).
ALLOWED_ORIGINS=
# Extra Host header values to allow. '*' accepts any Host (only behind a reverse proxy).
ALLOWED_HOSTS=
# Trust X-Forwarded-For. Enable only when a reverse proxy you control sets it.
TRUST_PROXY=false
# Rate limiting. On by default with a generous budget (owner decision 5).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_RPS=100
RATE_LIMIT_BURST=200

# --- Metrics ----------------------------------------------------------------
METRICS_ENABLED=true

# --- Logging ----------------------------------------------------------------
LOG_ENABLED=true
# info | debug. `debug` writes one file per request and enables stream capture.
LOG_LEVEL=debug
LOG_DIR=logs
LOG_FILE_NAME=proxy.log
LOG_MAX_BODY_CHARS=20000
LOG_MAX_FILE_SIZE_BYTES=5242880
LOG_MAX_ROTATED_FILES=5
LOG_SKIP_MCP_GET=true
LOG_SKIP_MCP_METHODS=initialize,notifications/initialized,notifications/progress,ping
LOG_SLOW_REQUEST_MS=2000
LOG_VERY_SLOW_REQUEST_MS=5000

# --- Log viewer -------------------------------------------------------------
LOG_VIEWER_ENABLED=true
LOG_VIEWER_MAX_FILE_BYTES=10485760
LOG_SUMMARY_MAX_LINES=200
